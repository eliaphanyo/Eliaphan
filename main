<body>
<div class="app" id="app">
  <!-- Главный экран -->
  <div id="homeScreen">
    <h1>Умный бизнес</h1>
    <div class="subhead">Управление NFC-метками</div>

    <!-- Список устройств -->
    <div id="devicesContainer"></div>

    <!-- Кнопка добавления -->
    <button class="btn" id="addDeviceBtn" style="margin-top: 20px;">
      <span class="btn-icon">＋</span> Добавить устройство
    </button>
  </div>
</div>

<!-- Оверлей: выбор варианта -->
<div class="overlay" id="variantOverlay">
  <div class="modal">
    <h2>Выберите устройство</h2>
    <p>Доступные для добавления:</p>
    <div class="variant-list">
      <div class="variant-item" data-variant="eliaphan">
        Eliaphan Smart NFC <span>метка 1</span>
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" id="closeVariantBtn">Отмена</button>
    </div>
  </div>
</div>

<!-- Оверлей: NFC верификация (добавление) -->
<div class="overlay" id="nfcAddOverlay">
  <div class="modal">
    <h2>NFC верификация</h2>
    <p>Приложите телефон к метке Eliaphan</p>
    <div class="nfc-pulse">
      <div class="nfc-icon">📱</div>
      <div class="nfc-hint">Ожидание метки...</div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" id="cancelNfcAddBtn">Отмена</button>
      <button class="btn" id="simulateNfcAddBtn">Найдена метка</button>
    </div>
  </div>
</div>

<!-- Оверлей: управление устройством (главное меню) -->
<div class="overlay" id="deviceControlOverlay">
  <div class="modal">
    <h2 id="controlDeviceName">Eliaphan Smart NFC</h2>
    <p id="controlDeviceDesc">метка 1 · активна</p>
    <div class="flex-col gap-8 mt-16">
      <button class="btn btn-outline" id="changeLinkBtn">Изменить ссылку</button>
      <button class="btn btn-outline" id="readLinkBtn">Прочитать ссылку</button>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" id="closeControlBtn">Закрыть</button>
    </div>
  </div>
</div>

<!-- Оверлей: изменение ссылки (ввод + NFC) -->
<div class="overlay" id="changeLinkOverlay">
  <div class="modal">
    <h2>Изменить ссылку</h2>
    <p>Вставьте новую ссылку и приложите метку</p>
    <input type="url" id="newLinkInput" placeholder="https://example.com" value="https://">
    <div class="nfc-pulse" style="padding: 8px 0;">
      <div class="nfc-icon" style="font-size: 48px;">📱</div>
      <div class="nfc-hint">Приложите телефон к метке для записи</div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" id="cancelChangeLinkBtn">Отмена</button>
      <button class="btn" id="writeLinkBtn">Записать</button>
    </div>
  </div>
</div>

<!-- Оверлей: чтение ссылки (NFC) -->
<div class="overlay" id="readLinkOverlay">
  <div class="modal">
    <h2>Чтение ссылки</h2>
    <p>Приложите телефон к метке для чтения</p>
    <div class="nfc-pulse">
      <div class="nfc-icon">📱</div>
      <div class="nfc-hint">Ожидание метки...</div>
    </div>
    <div class="link-preview hidden" id="readLinkResult"></div>
    <div class="modal-actions">
      <button class="btn btn-outline" id="cancelReadLinkBtn">Закрыть</button>
      <button class="btn" id="simulateReadBtn">Считать метку</button>
    </div>
  </div>
</div>

<script>
  (function() {
    // ---------- Состояние ----------
    // Устройства: массив объектов { id, name, variant, link }
    let devices = [];

    // Текущее устройство для управления (id)
    let currentDeviceId = null;

    // Ссылка, которая будет записана
    let pendingLink = '';

    // ---------- DOM элементы ----------
    const homeScreen = document.getElementById('homeScreen');
    const devicesContainer = document.getElementById('devicesContainer');
    const addDeviceBtn = document.getElementById('addDeviceBtn');

    // Оверлеи
    const variantOverlay = document.getElementById('variantOverlay');
    const nfcAddOverlay = document.getElementById('nfcAddOverlay');
    const deviceControlOverlay = document.getElementById('deviceControlOverlay');
    const changeLinkOverlay = document.getElementById('changeLinkOverlay');
    const readLinkOverlay = document.getElementById('readLinkOverlay');

    // Кнопки
    const closeVariantBtn = document.getElementById('closeVariantBtn');
    const cancelNfcAddBtn = document.getElementById('cancelNfcAddBtn');
    const simulateNfcAddBtn = document.getElementById('simulateNfcAddBtn');
    const closeControlBtn = document.getElementById('closeControlBtn');
    const changeLinkBtn = document.getElementById('changeLinkBtn');
    const readLinkBtn = document.getElementById('readLinkBtn');
    const cancelChangeLinkBtn = document.getElementById('cancelChangeLinkBtn');
    const writeLinkBtn = document.getElementById('writeLinkBtn');
    const cancelReadLinkBtn = document.getElementById('cancelReadLinkBtn');
    const simulateReadBtn = document.getElementById('simulateReadBtn');

    // Поля
    const newLinkInput = document.getElementById('newLinkInput');
    const readLinkResult = document.getElementById('readLinkResult');
    const controlDeviceName = document.getElementById('controlDeviceName');
    const controlDeviceDesc = document.getElementById('controlDeviceDesc');

    // ---------- Вспомогательные функции ----------
    function openOverlay(overlay) {
      overlay.classList.add('active');
    }

    function closeOverlay(overlay) {
      overlay.classList.remove('active');
    }

    function closeAllOverlays() {
      variantOverlay.classList.remove('active');
      nfcAddOverlay.classList.remove('active');
      deviceControlOverlay.classList.remove('active');
      changeLinkOverlay.classList.remove('active');
      readLinkOverlay.classList.remove('active');
    }

    // Отрисовка списка устройств
    function renderDevices() {
      if (devices.length === 0) {
        devicesContainer.innerHTML = `
          <div style="text-align: center; padding: 40px 0 20px; color: #aaa; font-size: 15px;">
            Нет добавленных устройств
          </div>
        `;
        return;
      }

      let html = '';
      devices.forEach(device => {
        html += `
          <div class="device-card" data-device-id="${device.id}">
            <div class="device-info">
              <div class="device-icon">📡</div>
              <div>
                <div class="device-name">${device.name}</div>
                <div class="device-tag">${device.variant} · ${device.link ? 'ссылка установлена' : 'ссылка не задана'}</div>
              </div>
            </div>
            <div class="chevron">›</div>
          </div>
        `;
      });
      devicesContainer.innerHTML = html;

      // Навешиваем обработчики на карточки
      document.querySelectorAll('.device-card').forEach(card => {
        card.addEventListener('click', (e) => {
          const id = card.dataset.deviceId;
          openDeviceControl(id);
        });
      });
    }

    // Открыть управление устройством
    function openDeviceControl(deviceId) {
      const device = devices.find(d => d.id === deviceId);
      if (!device) return;
      currentDeviceId = deviceId;
      controlDeviceName.textContent = device.name;
      controlDeviceDesc.textContent = `${device.variant} · ${device.link ? 'ссылка: ' + device.link : 'ссылка не задана'}`;
      openOverlay(deviceControlOverlay);
    }

    // ---------- Обработчики ----------

    // Добавление устройства
    addDeviceBtn.addEventListener('click', () => {
      openOverlay(variantOverlay);
    });

    // Закрыть выбор варианта
    closeVariantBtn.addEventListener('click', () => {
      closeOverlay(variantOverlay);
    });

    // Выбор варианта "Eliaphan Smart NFC"
    document.querySelectorAll('.variant-item').forEach(item => {
      item.addEventListener('click', () => {
        const variant = item.dataset.variant; // 'eliaphan'
        closeOverlay(variantOverlay);
        // Открыть NFC верификацию для добавления
        openOverlay(nfcAddOverlay);
      });
    });

    // Отмена NFC добавления
    cancelNfcAddBtn.addEventListener('click', () => {
      closeOverlay(nfcAddOverlay);
    });

    // Симуляция "найдена метка" при добавлении
    simulateNfcAddBtn.addEventListener('click', () => {
      // Генерируем ID
      const newId = 'device_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);
      const newDevice = {
        id: newId,
        name: 'Eliaphan Smart NFC',
        variant: 'метка 1',
        link: '' // изначально ссылка не задана
      };
      devices.push(newDevice);
      renderDevices();
      closeOverlay(nfcAddOverlay);
      // Можно сразу открыть управление? По желанию. Оставим главный экран.
    });

    // Закрыть управление устройством
    closeControlBtn.addEventListener('click', () => {
      closeOverlay(deviceControlOverlay);
      currentDeviceId = null;
    });

    // Изменить ссылку
    changeLinkBtn.addEventListener('click', () => {
      closeOverlay(deviceControlOverlay);
      // Очистим поле ввода и подставим текущую ссылку, если есть
      const device = devices.find(d => d.id === currentDeviceId);
      if (device && device.link) {
        newLinkInput.value = device.link;
      } else {
        newLinkInput.value = 'https://';
      }
      openOverlay(changeLinkOverlay);
    });

    // Отмена изменения ссылки
    cancelChangeLinkBtn.addEventListener('click', () => {
      closeOverlay(changeLinkOverlay);
      // Возвращаемся к управлению? Можно открыть заново
      if (currentDeviceId) {
        openDeviceControl(currentDeviceId);
      }
    });

    // Запись ссылки (NFC)
    writeLinkBtn.addEventListener('click', () => {
      const newLink = newLinkInput.value.trim();
      if (!newLink) {
        alert('Введите ссылку');
        return;
      }
      // Сохраняем pendingLink
      pendingLink = newLink;
      // Симулируем запись: сразу применяем
      const device = devices.find(d => d.id === currentDeviceId);
      if (device) {
        device.link = newLink;
        // Обновляем описание в управлении
        controlDeviceDesc.textContent = `${device.variant} · ссылка: ${device.link}`;
        renderDevices();
      }
      closeOverlay(changeLinkOverlay);
      // Возвращаемся к управлению
      if (currentDeviceId) {
        openDeviceControl(currentDeviceId);
      } else {
        closeAllOverlays();
      }
    });

    // Чтение ссылки
    readLinkBtn.addEventListener('click', () => {
      closeOverlay(deviceControlOverlay);
      // Сбросим результат
      readLinkResult.classList.add('hidden');
      readLinkResult.textContent = '';
      openOverlay(readLinkOverlay);
    });

    // Отмена/закрытие чтения
    cancelReadLinkBtn.addEventListener('click', () => {
      closeOverlay(readLinkOverlay);
      if (currentDeviceId) {
        openDeviceControl(currentDeviceId);
      }
    });

    // Симуляция чтения метки
    simulateReadBtn.addEventListener('click', () => {
      const device = devices.find(d => d.id === currentDeviceId);
      let linkText = 'Ссылка не найдена';
      if (device && device.link) {
        linkText = device.link;
      } else if (device) {
        linkText = 'Ссылка не записана на метку';
      }
      readLinkResult.textContent = '🔗 ' + linkText;
      readLinkResult.classList.remove('hidden');
      // Через 1.5 секунды можно закрыть? Оставим открытым, пользователь закроет.
    });

    // Закрытие оверлеев по клику на фон (вне модального окна)
    document.querySelectorAll('.overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          // Не закрываем, если это критично? Закроем все, кроме, может, nfc? Для простоты закроем.
          // Но лучше закрывать только по кнопке, чтобы не сбить. Оставим без закрытия по фону, чтобы избежать случайностей.
        }
      });
    });

    // Инициализация: отрисовка
    renderDevices();

    // Небольшой хак: для удобства, если пользователь нажмёт "Найдена метка" без выбора варианта – не случится.
    // Всё ок.

  })();
</script>
</body>
</html>
